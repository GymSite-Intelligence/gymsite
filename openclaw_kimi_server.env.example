# Copie para openclaw_kimi_server.env (gitignored) ou exporte antes do uvicorn.

# --- Groq com busca web (recomendado) ---
KIMI_BACKEND=groq
GROQ_API_KEY=gsk_YOUR_KEY_HERE
GROQ_MODEL=groq/compound-mini
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Ollama local (dev offline) ---
# KIMI_BACKEND=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

OPENCLAW_TOKEN=your-shared-bearer-token
PORT=8001
KIMI_TIMEOUT_SEC=120
