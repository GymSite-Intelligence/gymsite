{
  "name": "gymsite-intelligence",
  "private": true,
  "description": "Monorepo GymSite — scripts na raiz delegam para frontend/ e api.py",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:api": "python -m uvicorn api:app --reload --host 127.0.0.1 --port 8000"
  },
  "dependencies": {
    "@google/genai": "^2.16.0"
  }
}
