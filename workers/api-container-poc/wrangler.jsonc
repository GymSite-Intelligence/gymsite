{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gymsite-api-container-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "GymSiteApiContainer",
      "image": "../../Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GYMSITE_API",
        "class_name": "GymSiteApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GymSiteApiContainer"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
