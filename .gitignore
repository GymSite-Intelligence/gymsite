!cloudflared/config.yml

# PDF samples gerados localmente
artifacts/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# ADK
.adk/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Node / Vite
node_modules/
frontend/dist/
frontend/dist-types-node/
.pnpm-store/
**/*.tsbuildinfo

# Dados de referência locais (PDF/CSV pesados — manter fora do git)
docs/*.pdf
docs/series-historicas*.csv

# Playwright runtime
.playwright-mcp/

# Logs e backups locais
*.log
*.bak

# Screenshots de debug (não versionar — usar Linear/Notion se precisar guardar)
*.png

# Deep Research cache (estrutura versionada via .gitkeep, conteúdo ignorado)
market_context/*.md

# Token telemetry (estrutura versionada via .gitkeep, dados ignorados)
metrics/*.csv

# Pipeline / LLM caches locais (não versionar conteúdo gerado em runtime)
metrics/grounding_cache/*.json
metrics/relatorios/*.json
metrics/cache/*.json
metrics/state_diagnostics.jsonl
metrics/rfb_cnpj_cache/

# Dumps RFB / artefatos grandes
*.zip

# Popular times cache (estrutura versionada via .gitkeep, conteúdo ignorado)
competitor_cache/*.json
competitor_cache/*.md

# Serena MCP — estado local do assistente, nao versionar
.serena/

# OpenClaw edge — sandbox local de runtime (Dockerfile sandbox, openclaw.json
# com tokens locais, .env, browser profile, sessions, cache). Decisao
# pendente sobre versionar openclaw.example.json quando promover.
.openclaw-edge/

# Scratch e ferramentas locais do Gemini Antigravity
scratch/
.gemini/
