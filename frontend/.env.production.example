# Variáveis para build de produção (Cloudflare Pages / CI).
# Copie para o painel do deploy — NÃO commitar secrets.

VITE_USE_MOCKS=false

# Supabase (mesmo projeto usado em dev)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# API FastAPI em produção (GYM-02 tunnel)
# IMPORTANTE: use o domínio público da API GymSite (tunnel/Cloud Run).
VITE_API_BASE=https://api.getgymsite.com.br
