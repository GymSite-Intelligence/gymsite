# Variáveis para build de produção (Cloudflare Pages / CI).
# Copie para o painel do deploy — NÃO commitar secrets.

VITE_USE_MOCKS=false

# Supabase (mesmo projeto usado em dev)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# API FastAPI em produção (A0–A9 logado)
VITE_API_BASE=https://api.getgymsite.com.br

# Chat/análise grátis: Worker same-origin (não Cloud Run)
VITE_DEGUSTACAO_PROVIDER=cloudflare
VITE_TURNSTILE_SITEKEY=
