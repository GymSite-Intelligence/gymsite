# Toggle entre mocks locais e Supabase real.
# .env.local sobrescreve este arquivo — use VITE_USE_MOCKS=false quando Supabase estiver configurado.
VITE_USE_MOCKS=true

# Supabase (preencher quando projeto gymsite-intelligence for criado)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API backend (FastAPI) — default http://localhost:8000
# VITE_API_BASE=http://localhost:8000

# Google Maps — mesma GOOGLE_MAPS_API_KEY do .env da raiz (server-side).
# FastAPI lê daqui ao subir api.py; o browser só chama POST {VITE_API_BASE}/api/places-autocomplete.
# Cloud Console: billing + Places API (New) + Geocoding API no projeto da chave.
# GOOGLE_MAPS_API_KEY=

# ── shadcn private registry (CLI lê do ambiente, não do Vite) ───────────────
# Uso: REGISTRY_TOKEN=xxx npx shadcn@latest add @gymsite/meu-componente
REGISTRY_URL=https://registry.gymsite.local
REGISTRY_TOKEN=
