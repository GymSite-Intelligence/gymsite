# Toggle entre mocks locais e Supabase real.
# .env.local sobrescreve este arquivo — use VITE_USE_MOCKS=false quando Supabase estiver configurado.
VITE_USE_MOCKS=true

# Supabase (preencher quando projeto gymsite-intelligence for criado)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Degustação pública: Worker same-origin (`/api/site-agent/*`).
# VITE_DEGUSTACAO_PROVIDER=cloudflare ignora VITE_API_BASE no siteAgent (A0–A9 usa supabase.ts).
# VITE_DEGUSTACAO_PROVIDER=cloudflare

# API backend (FastAPI) — default http://localhost:8000
# VITE_API_BASE=http://localhost:8000
# Caminho relativo da API quando servida atrás do mesmo domínio (default /api)
# VITE_API_URL=/api

# Dev: tratar usuário local como admin (NUNCA ligar em produção)
# VITE_DEV_AS_ADMIN=false

# Google Maps — mesma GOOGLE_MAPS_API_KEY do .env da raiz (server-side).
# FastAPI: POST /api/places-autocomplete e GET /api/config/maps-js (heatmap /mapa).
# Cloud Console: Places API (New), Geocoding, Maps JavaScript API, Maps Visualization.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=   # opcional — Advanced Markers no Cloud Console
# VITE_GOOGLE_MAPS_MAP_ID=  # opcional — sobrescreve map_id no frontend
# VITE_MAP_PROVIDER=google   # google | pigeon (fallback OSM)

# Redis Memory — REST API (session + long-term semantic memory; server-side only)
# REDIS_MEMORY_API_BASE=https://gcp-us-east4.memory.redis.io/v1
# REDIS_MEMORY_STORE_ID=your-store-id
# REDIS_MEMORY_API_KEY=mem1_...

# LangCache — cache semântico LLM (server-side only)
# LANGCACHE_SERVER_URL=https://gcp-us-east4.langcache.redis.io
# LANGCACHE_CACHE_ID=your-cache-id
# LANGCACHE_API_KEY="lc1_..."
# LANGCACHE_EMBEDDING_MODEL=langcache-embedding-model-v3-small
# LANGCACHE_SIMILARITY_THRESHOLD=0.85
