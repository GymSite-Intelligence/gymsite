# =============================================================================
# GymSite Intelligence — Production Environment Template
# =============================================================================
# COPIE este arquivo para .env.production e preencha os valores reais.
# NUNCA versione .env.production no git.
# =============================================================================

# ─── Gemini / ADK ───
GOOGLE_GENAI_USE_VERTEXAI=false
# Hot-path A0–A9: nvidia | gemini | vertex (vazio = auto). Com Vertex billing off use nvidia.
PIPELINE_LLM_PROVIDER=nvidia
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GOOGLE_GENAI_MODEL=gemini-3.6-flash
# Side-tools Gemini (refino lançamento): off automático com PIPELINE_LLM_PROVIDER=nvidia.
# Opt-in: GEMINI_SIDE_TOOLS=1 + chave AIzaSy... (AI Studio). AQ.* NÃO funciona.
# GEMINI_SIDE_TOOLS=0
# Distance Matrix GCP: off (frete usa estimativa por UF). Opt-in raro:
# DISTANCE_MATRIX_ENABLED=0
# GOOGLE_DISTANCE_MATRIX_API_KEY=

# ─── Turnstile (anti-bot do /api/site-agent) ───
# OBRIGATÓRIO: Secret Key do MESMO widget cuja Site Key o front usa
# Turnstile siteverify (widget getgymsite-analise-gratuita, sitekey 0x4AAAAAADouAKkqNK0u3OaG).
# Secret from Cloudflare dashboard / API — never commit real value.
# TURNSTILE_SECRET=
# Opcionais (caps /analise):
# SITE_AGENT_CAP_IP_DIA=5
# SITE_AGENT_CAP_GLOBAL_DIA=100
# TTL do capability token (poll análise grátis); default 48h
# SITE_ANALISE_TOKEN_TTL_HOURS=48
# Caps chat /conversar (Redis; fail-closed se Redis down):
# SITE_CHAT_SESSOES_IP_DIA=2
# SITE_CHAT_TURNOS_PROJETO=10
# SITE_CHAT_MODO_DEGUSTACAO=1
# Bypass ops (nunca em prod pública sem necessidade):
# SITE_ANALISE_EMAIL_BYPASS=
# SITE_CHAT_BYPASS_TOKEN=
# SITE_CHAT_IP_ALLOWLIST=

DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
DEEP_RESEARCH_TIMEOUT_SEC=420
DEEP_RESEARCH_POLL_SEC=10
DEEP_RESEARCH_FALLBACK_MODEL=gemini-3.6-flash

# ─── Google Maps Platform (opcional — fallback) ───
# Geo primário = OSM (Nominatim + Valhalla). Concorrentes = SearchAPI.
# Esta chave só se quiser Places/Geocoding Google como reserva.
GOOGLE_MAPS_API_KEY=
# Chave BROWSER (mapa do frontend via /api/config/maps-js): SOMENTE Maps
# JavaScript API, restrita por referrer (gymsite.vectracargo.com.br,
# *.gymsite-3p0.pages.dev). É entregue ao navegador — é pública por design.
GOOGLE_MAPS_BROWSER_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY_HERE
MAPS_FALLBACK_ENABLED=1
# Isócronas /explorar (5/10/15 min). Sem chave = Valhalla OSM.de público.
# ORS_API_KEY=

# ─── CORS (FastAPI) ───
# Produção: lista de origens separadas por vírgula (sem espaços).
# Inclua front + hosts do túnel (staging Hetzner antes do cutover):
#   getgymsite, gymsite.vectracargo, api-hetzner (staging), gymsite-api, api.getgymsite
CORS_ORIGINS=https://getgymsite.com.br,https://gymsite.vectracargo.com.br,https://api-hetzner.getgymsite.com.br,https://gymsite-api.vectracargo.com.br,https://api.getgymsite.com.br,https://api.vectracargo.com.br

# Prod API+worker = Hetzner + Cloudflare Tunnel (Navi Vectra / VectraCargo).
# Cloud Run esta DEPRECADO — nunca gcloud run deploy.
# Projeto canonico Vertex/BQ: gen-lang-client-0106729343 ("Navi Vectra").
# NUNCA usar o orfao gen-lang-client-0662901510 (ADR-008).
# --- GCP (Vertex / BQ billing — NAO e o host da API) ---
GOOGLE_CLOUD_PROJECT=gen-lang-client-0106729343
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
SERVICE_ACCOUNT_EMAIL=gymsite-intelligence@gymsite-intelligence.iam.gserviceaccount.com

# ─── BigQuery / IBGE ───
IBGE_BIGQUERY_PROJECT=gymsite-intelligence
BIGQUERY_LOCATION=us

# --- Cloud Run (LEGADO — nao deployar; API = Hetzner) ---
# CLOUD_RUN_REGION=us-central1

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_GYMSITE_ORG_ID=00000000-0000-0000-0000-000000000001

# ─── Eros RAG (Edge Function knowledge-ask) — projeto assistent-control ───
# URL/key do Supabase Eros (NÃO o DB GymSite). Groups = eros_knowledge_groups.id
EROS_SUPABASE_URL=https://gxmaxbjgdrqdcizvdojp.supabase.co
EROS_SUPABASE_SERVICE_ROLE_KEY=
EROS_GROUP_ID_MERCADO=
EROS_GROUP_ID_WELLHUB=
EROS_GROUP_ID_TOTALPASS=
EROS_GROUP_ID_GURUPASS=
EROS_GROUP_ID_REGULATORIO=
EROS_GROUP_ID_TECNICO=
EROS_GROUP_ID_ARQUITETO=
EROS_GROUP_ID_ENGENHARIA=

# ─── CNO (obras RFB) — volume montado no container ───
CNO_DATA_DIR_HOST=/opt/gymsite/cno_data
CNO_DATA_DIR=/data/cno

# ─── Redis ───
# Docker local/prod com serviço redis no compose:
# REDIS_URL=redis://redis:6379/0
# Redis Cloud (Redis Labs) — use host:port + user default:
# REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.redislabs.com:PORT/0
REDIS_URL=redis://redis:6379/0

# ─── Chat LLM (consultor / site) ───
# Default no servidor; override runtime via GET/PATCH /api/admin/llm-config (Redis).
# Secrets NUNCA vão pra UI — só NVIDIA_API_KEY / GOOGLE_* neste arquivo.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY_HERE
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Fallback A0–A9 se NVIDIA 429/410: Ollama no HOST da VPS (não 127.0.0.1 dentro do container).
PIPELINE_OLLAMA_FALLBACK=1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# GYMSITE_SITE_MODEL=gemini-3.6-flash

# Vertex AI Search (Discovery) — DEPRECATED. Default off.
# Opt-in legado só com VERTEX_RAG_ENABLED=1. Preferir Eros RAG.
VERTEX_RAG_ENABLED=0
# EROS_GROUP_ID_MERCADO=7b471b98-bfc8-4c7e-a58f-a0e95edede7b  # Metodologia (~819)
# EROS_GROUP_ID_WELLHUB=553fa8d6-e3d2-440a-ba0b-867fb5363627
# EROS_GROUP_ID_TOTALPASS=6ab0c39b-bf81-4840-9dcc-ed5f5cc86117
# EROS_GROUP_ID_GURUPASS=4d1e2c40-217b-4a39-bc08-f9c3e90fd803
# EROS_GROUP_ID_MERCADO_RECEITA=b2bce16f-3695-4d93-94c5-4bd77bdb92d6  # CNAE aggregate only — NÃO no chat
# EROS_GROUP_ID_REGULATORIO=b7dad505-2d2a-49a9-bbaf-d4b9c4929dea
# EROS_GROUP_ID_ENGENHARIA=f087bfc8-ad2b-434c-bc18-a38608be183d
# EROS_GROUP_ID_ARQUITETO=   # vazio = fallback Engenharia
# EROS_GROUP_ID_TECNICO=cfd31e7f-e108-4bf2-a308-8663a536f9f4
# Projeto assistent-control (knowledge-ask) — separado do SUPABASE_URL GymSite:
# EROS_SUPABASE_URL=https://gxmaxbjgdrqdcizvdojp.supabase.co
# EROS_SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenTelemetry (opcional) ───
OTEL_SERVICE_NAME=gymsite-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YOUR_BASE64_INSTANCEID_APITOKEN
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# ─── Resend (e-mail transacional / drip degustação) ───
# Domínio verificado no Resend: gymsite.com.br
RESEND_API_KEY=
RESEND_FROM=GymSite <contato@gymsite.com.br>

# ─── CNPJ / Apollo (entrantes no relatório) ───
# Receita+QSA no pipeline A6: desligado por padrão (lista só snapshot Supabase).
CNPJ_ENRIQUECER_QSA=1
CNPJ_ENRIQUECER_MAX=3
# Apollo só na UI «Enriquecer» ou se APOLLO_ENRICH_ON_PIPELINE=1
APOLLO_ENRICH_ON_PIPELINE=0
# Header x-api-key (não colocar na URL). Master key para People API Search.
APOLLO_API_KEY=
# people/match — revelar e-mail pessoal (consome créditos)
APOLLO_REVEAL_PERSONAL_EMAILS=1
# Sequence Apollo (legado). Explorar/degustação usam Resend — não ligar isto
# só pra cadência de e-mail. Ativar só se a sequence Apollo estiver revisada.
# APOLLO_SYNC_ENABLED=false
APOLLO_SEQUENCE_ID=
# Caixa remetente sequence (resolve ID via API ou setar APOLLO_EMAIL_ACCOUNT_ID direto)
APOLLO_SENDER_EMAIL=suporte@gymsite.com.br
APOLLO_EMAIL_ACCOUNT_ID=

# ─── Pipeline ───
# Teto wall-clock por relatório (segundos). Default 1800 = 30 min.
# Ondas Market Atlas / bairros densos: use 3600 (1h).
# OBRIGATÓRIO no gymsite-api E gymsite-worker (pipeline ADK roda no worker Redis).
# Drift API-only → mensagem "30 min" mesmo com API em 3600 (caso ed36ed08 jul/2026).
PIPELINE_MAX_WALL_SEC=3600
PIPELINE_ORPHAN_MINUTES=35
# ─── A3a enrich ───
# Knowledge Panel Playwright no hot-path: default OFF (SPEC_market_bundle_v2).
# Reviews/maps = SearchAPI + cache_reviews / search_raw.
COMPETITOR_PLAYWRIGHT_ENRICH=0
MAX_ENRIQUECIMENTO=3
# Opt-in bundle no Supabase (worker + batch)
MARKET_BUNDLE_SUPABASE=1
# Secret compartilhado: Cloud Run gymsite-worker + gymsite.cron_http_targets.secret
MARKET_BATCH_CRON_SECRET=YOUR_CRON_SECRET_HERE

# ─── Rate Limit / Observability ───
LOG_LEVEL=info

# ─── Gemini (cliente genai direto — tools/_genai_client.py) ───
# GEMINI_API_KEY tem precedência sobre GOOGLE_API_KEY no cliente genai.
# Pode apontar para a mesma chave do GOOGLE_API_KEY acima.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
TINKER_API_KEY=
TINKER_FALLBACK_MODEL=gemini-3.6-flash

# ─── A0 Research / market bundle ───
# Espelhar no gymsite-worker. ckan_bundle = bloqueia Deep Research se bundle ok.
# auto | ckan_bundle | deep_research_fallback
A0_CONTEXT_SOURCE=ckan_bundle
# auto | gemini | kimi
A0_RESEARCH_PROVIDER=kimi
KIMI_RESEARCH_TIMEOUT_SEC=90

# ─── MCP Server (mcp_server.py) ───
GYMSITE_API_KEY=YOUR_GYMSITE_MCP_API_KEY_HERE

# ─── Security audit (GitHub Actions manual — tools/security_audit) ───
# Configure once: python scripts/setup_github_security_audit_secrets.py --login-from-env
# Or: gh secret set SECURITY_AUDIT_TOKEN --body "<supabase-jwt-user-a>"
# Optional: SECURITY_AUDIT_USER_B_TOKEN, SECURITY_AUDIT_RELATORIO_USER_A, SECURITY_AUDIT_RELATORIO_USER_B
# Local env for login helper (never commit):
# SECURITY_AUDIT_USER_A_EMAIL= SECURITY_AUDIT_USER_A_PASSWORD=
# SECURITY_AUDIT_USER_B_EMAIL= SECURITY_AUDIT_USER_B_PASSWORD=

# ─── Admin (backend/routers/parceiros_admin.py) ───
# Emails com acesso admin além de user_metadata.role=admin (separados por vírgula)
ADMIN_EMAILS=marcelo.rosas@vectracargo.com.br

# ─── OpenClaw / Prospecção (prospecting/, tools/kimi_research.py) ───
CLAW_WEBHOOK_URL=
CLAW_WEBHOOK_SECRET=YOUR_CLAW_WEBHOOK_SECRET_HERE
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_KIMI_SEARCH_PATH=/kimi/search

# ─── Popular Times (tools/popular_times_tool.py) — tiers opcionais ───
# Tier 0: SearchAPI free 100 req/mês. Tier 1: lib populartimes exige chave
# DEDICADA com Places API LEGACY habilitada (NUNCA reusar a chave server).
# Sem ambos, o Playwright (tier 2) cobre sozinho.
SEARCHAPI_KEY=
PLACES_API_KEY_LEGACY=

# ─── Google Distance Matrix (tools/distance_matrix_tools.py) ───
# Pode ser a mesma GOOGLE_MAPS_API_KEY se a API estiver habilitada no projeto
GOOGLE_DISTANCE_MATRIX_API_KEY=

# ─── LangCache — cache semântico LLM (tools/langcache_client.py) ───
LANGCACHE_SERVER_URL=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
REDIS_GENERATE_KEY=
