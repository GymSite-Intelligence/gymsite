# =============================================================================
# GymSite Intelligence — Production Environment Template
# =============================================================================
# COPIE este arquivo para .env.production e preencha os valores reais.
# NUNCA versione .env.production no git.
# =============================================================================

# ─── Gemini / ADK ───
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GOOGLE_GENAI_MODEL=gemini-2.5-flash

DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
DEEP_RESEARCH_TIMEOUT_SEC=420
DEEP_RESEARCH_POLL_SEC=10
DEEP_RESEARCH_FALLBACK_MODEL=gemini-2.5-flash

# ─── Google Maps Platform ───
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
MAPS_FALLBACK_ENABLED=1

# ─── CORS (FastAPI) ───
# Produção: lista de origens separadas por vírgula (sem espaços).
# Inclua os domínios do Cloudflare Tunnel + frontend:
#   api.vectracargo.com.br, gymsite-api.vectracargo.com.br, gymsite.vectracargo.com.br
CORS_ORIGINS=https://api.vectracargo.com.br,https://gymsite-api.vectracargo.com.br,https://gymsite.vectracargo.com.br

# ─── GCP ───
GOOGLE_CLOUD_PROJECT=gen-lang-client-0662901510
GOOGLE_CLOUD_LOCATION=southamerica-east1
GOOGLE_CLOUD_REGION=southamerica-east1
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
SERVICE_ACCOUNT_EMAIL=gymsite-intelligence@gymsite-intelligence.iam.gserviceaccount.com

# ─── BigQuery / IBGE ───
IBGE_BIGQUERY_PROJECT=gymsite-intelligence
BIGQUERY_LOCATION=us

# ─── Cloud Run ───
CLOUD_RUN_REGION=southamerica-east1

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_GYMSITE_ORG_ID=00000000-0000-0000-0000-000000000001

# ─── CNO (obras RFB) — volume montado no container ───
CNO_DATA_DIR_HOST=/opt/gymsite/cno_data
CNO_DATA_DIR=/data/cno

# ─── Redis (container interno via docker-compose.prod.yml) ───
REDIS_URL=redis://redis:6379/0

# ─── OpenTelemetry (opcional) ───
OTEL_SERVICE_NAME=gymsite-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YOUR_BASE64_INSTANCEID_APITOKEN
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# ─── Rate Limit / Observability ───
LOG_LEVEL=info
