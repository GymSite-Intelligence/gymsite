# ============================================================
# db/.env.example — variáveis necessárias pro adapter Supabase
# ============================================================
# Adicione estas linhas ao seu gymsite_intelligence/.env (NÃO commitar)
# Quando o projeto Supabase gymsite-intelligence for criado, pegue
# as credenciais em: Dashboard → Project Settings → API

# URL do projeto (formato https://<ref>.supabase.co)
SUPABASE_URL=

# Service Role Key (NÃO a anon key — service tem bypass de RLS, usar só no backend)
SUPABASE_SERVICE_ROLE_KEY=

# UUID da organização Vectra (default criado pelo seed.sql)
# Pode ser diferente se rodar pra clientes externos
SUPABASE_GYMSITE_ORG_ID=00000000-0000-0000-0000-000000000001

# ============================================================
# Comportamento quando AUSENTE:
# Adapter detecta credenciais faltando e faz no-op silencioso.
# Pipeline continua salvando JSON em metrics/relatorios/ normalmente.
# Logs do writer (incluindo no-ops) em metrics/supabase_writes/writer.log
# ============================================================
